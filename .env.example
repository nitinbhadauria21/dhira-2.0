# Dhira — environment variables
#
# HOW TO USE (plain English):
# 1. Copy this file to a new file called ".env.local"  (that file is git-ignored and safe for real keys).
# 2. Paste your real keys after the "=" signs.
# 3. Restart the dev server (npm run dev).
#
# Nothing here is required just to CLICK around the app — Dhira runs in a safe
# "offline" mode with a local data file when these are blank. Fill them in to
# switch on the real Claude brain and cloud saving.

# --- Dhira's AI brain (preferred: OpenRouter) ---
# Plain English: one OpenRouter key powers all six Dhira agents.
# 1. Sign in at https://openrouter.ai → Keys → Create Key (looks like sk-or-v1-...).
# 2. Add a little credit under Billing/Credits.
# 3. Paste the key below. Restart npm run dev.
# Keep it secret — never commit real keys.
OPENROUTER_API_KEY=

# Optional model overrides (OpenRouter model IDs). Defaults are fine for most demos.
# DHIRA_MODEL_SONNET=anthropic/claude-sonnet-4.5
# DHIRA_MODEL_HAIKU=anthropic/claude-haiku-4.5

# Legacy fallback: direct Anthropic key (only if you are NOT using OpenRouter).
# Get this from https://console.anthropic.com → API Keys → Create Key.
ANTHROPIC_API_KEY=

# --- Cloud database (Supabase) — optional ---
# From your Supabase project: Settings → API (or Project Settings → API Keys).
# Paste real values into `.env.local` (git-ignored), not into this file.
# If these are blank, Dhira saves to a local file (.data/) instead, which is
# perfect for a single-laptop demo.
#
# Newer Supabase keys look like:
#   publishable/anon → sb_publishable_...   (goes in NEXT_PUBLIC_SUPABASE_ANON_KEY)
#   secret/service   → sb_secret_...        (goes in SUPABASE_SERVICE_ROLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service-role / secret key is used only on the server. NEVER put it in
# NEXT_PUBLIC_* vars and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Proactive check-in endpoint protection ---
# A shared password so only your reminder tool (n8n) can trigger check-ins.
# Make up any long random string.
CHECKIN_SECRET=

# --- Notifications via Emergent (email + WhatsApp) ---
# Dhira writes a notification row then POSTs it to your Emergent workflow, which
# delivers via its own providers (Twilio/Gmail). Leave blank in dev/demo — then
# notifications are recorded and marked "sent" without an external provider.
EMERGENT_NOTIFY_WEBHOOK_URL=
EMERGENT_WEBHOOK_SECRET=
# --- Twilio WhatsApp Integration ---
# E.164 only (no whatsapp: prefix), e.g. +17016958623
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# Inbound webhook signature check (default on when TWILIO_AUTH_TOKEN is set). Set false for local curl tests.
# TWILIO_VALIDATE_WEBHOOK=false
WHATSAPP_ENABLED=false
# Public URL of this app (used so Emergent can call the delivery-status callback).
# Local Cursor is the only product host — keep both as localhost:4028 while developing.
APP_URL=http://localhost:4028
NEXT_PUBLIC_SITE_URL=http://localhost:4028

# --- Talk to Dhira (ElevenLabs voice agent) ---
# Server-only key from https://elevenlabs.io — required when your agent has authentication enabled.
# The app calls GET /api/elevenlabs/session to fetch a signed URL or token (never expose this key in the browser).
ELEVENLABS_API_KEY=
# Optional override (defaults to the agent id embedded in the widget if unset).
# ELEVENLABS_AGENT_ID=agent_...
